{
  "name": "courtsense",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "wrangler types --strict-vars=false && tsc -b",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply courtsense --local",
    "db:migrate:remote": "wrangler d1 migrations apply courtsense --remote",
    "types": "wrangler types --strict-vars=false",
    "mock:gemini": "node scripts/mock-gemini.mjs",
    "smoke": "scripts/smoke.sh",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "mediabunny": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
